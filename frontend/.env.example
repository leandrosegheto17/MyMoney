# Variáveis de ambiente do Frontend (MyMoney PWA)
#
# Este arquivo documenta apenas NOMES de variáveis, nunca valores reais de
# segredo — conforme escopo do DevOps (infrastructure-as-code-provisioning /
# cicd-pipeline-configuration). Valores reais são configurados diretamente no
# painel do provedor de hospedagem (Vercel) por ambiente (staging/production),
# nunca commitados neste repositório.
#
# Convenção de prefixo: toda variável exposta ao bundle do cliente (Vite) usa
# o prefixo VITE_ — qualquer coisa com esse prefixo é, por definição, PÚBLICA
# no bundle final. Segredo de provedor externo (STT cloud, OCR, Pluggy) NUNCA
# entra aqui — vive em Supabase Vault/secrets do lado do servidor (Edge
# Functions), nunca em variável de build do Frontend (DIR-30/G-11 do
# GUARDRAILS.md).

# URL do projeto Supabase (reaproveitado — ADR-012, supersede ADR-001) — pública por design.
VITE_SUPABASE_URL=

# Chave anônima (anon key) do Supabase — pública por design; autorização real
# é garantida por RLS (RLS habilitada em toda tabela do schema `public`
# associada a este produto, policy `auth.uid() = user_id`, ver GUARDRAILS.md
# G-04/ADR-012), nunca pela chave em si ficar "escondida".
VITE_SUPABASE_ANON_KEY=

# Identificador do ambiente atual, usado só para exibição/telemetria no client
# (ex.: badge "staging" na UI, tag de ambiente em métrica de erro) — nunca usado
# para decisão de autorização.
VITE_APP_ENV=

# Chave pública VAPID para Web Push (EXT-05, RF-F2-09) — a chave PRIVADA
# correspondente fica em secret server-side (Supabase Edge Function), nunca
# aqui.
VITE_VAPID_PUBLIC_KEY=
