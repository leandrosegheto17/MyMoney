{
  "name": "mymoney",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . --no-error-on-unmatched-pattern && pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "local:subir": "supabase start --workdir backend && pnpm --filter @mymoney/web --if-present dev",
    "local:resetar": "supabase db reset --workdir backend",
    "local:parar": "supabase stop --workdir backend",
    "test:config": "node --test \"backend/supabase/verificacoes/*.test.mjs\"",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
